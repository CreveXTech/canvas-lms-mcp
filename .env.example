# --- Canvas (required) ---
# Generate at Canvas > Account > Settings > New Access Token.
CANVAS_API_TOKEN=your_canvas_api_token_here
CANVAS_BASE_URL=https://canvas.youruniversity.edu/api/v1

# --- Transport ---
# stdio (default) for a locally spawned server, http for the container.
MCP_TRANSPORT=stdio

# --- HTTP transport (required when MCP_TRANSPORT=http) ---
# Bearer token clients must present. Generate one with:
#   openssl rand -hex 32
MCP_AUTH_TOKEN=
# MCP_HTTP_PORT=3000
# MCP_HTTP_HOST=0.0.0.0
# MCP_ALLOWED_HOSTS=localhost:3000,127.0.0.1:3000

# --- Remote access over Tailscale (compose only) ---
# Interface compose publishes port 3111 on. That host's Tailscale IP, from
# `tailscale ip -4`. Leave unset for loopback-only.
# MCP_BIND_ADDR=100.64.0.1
# Every host:port a client may dial. A name missing here returns 403.
# MCP_ALLOWED_HOSTS=localhost:3111,127.0.0.1:3111,yourhost.your-tailnet.ts.net:3111,100.64.0.1:3111

# --- Tool surface (optional) ---
# Trim which tools the server advertises. Patterns match a tool name or a group
# name, and * is a wildcard. Groups: courses, assignments, modules, pages,
# discussions, quizzes, submissions, files, people, user, calendar,
# conversations, misc.
# Allowlist; unset means every tool.
# CANVAS_TOOLS=courses,assignments,modules,get_grades
# Denylist, applied after the allowlist.
# CANVAS_DISABLED_TOOLS=conversations,misc,list_external_tools

# --- Canvas API tuning (optional) ---
# CANVAS_PER_PAGE=100
# CANVAS_TIMEOUT_MS=30000
# Safety stop on pagination; 20 pages x 100 = 2000 records per call.
# CANVAS_MAX_PAGES=20
# Concurrent Canvas requests when a tool must fan out (e.g. get_module).
# CANVAS_MAX_CONCURRENCY=5
